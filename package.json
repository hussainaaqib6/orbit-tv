{
  "name": "orbit-tv",
  "productName": "Matrix 8K Player",
  "version": "2.0.0",
  "description": "Matrix 8K Player: an IPTV player for Fire TV, Android, iPhone/iPad and desktop. Bring your own Xtream Codes, M3U or MAC portal playlist.",
  "main": "desktop/main.js",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.3",
    "@capacitor/core": "8.6.3",
    "@capacitor/ios": "8.6.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/lexend": "5.3.0",
    "@preact/signals": "2.5.1",
    "hls.js": "1.6.15",
    "lucide-preact": "1.80.0",
    "mpegts.js": "1.8.0",
    "preact": "10.29.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "@eslint/js": "9.39.1",
    "@preact/preset-vite": "2.10.6",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "eslint": "9.39.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "build": {
    "appId": "com.matrixstreams.player",
    "productName": "Matrix 8K Player",
    "files": [
      "desktop/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
