{
  "name": "orbit-tv",
  "productName": "Orbit TV",
  "version": "1.0.0",
  "description": "IPTV player for Android phones, Fire TV, iPhone/iPad and desktop. Bring your own M3U or Xtream Codes playlist.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node scripts/vendor.js",
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-video-player": "9.0.1",
    "bonjour-service": "1.4.4",
    "castv2-client": "1.2.0",
    "hls.js": "1.5.20",
    "mpegts.js": "1.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "tv.orbit.player",
    "productName": "Orbit TV",
    "files": [
      "main.js",
      "desktop/**/*",
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}