{
  "appId": "com.matrixstreams.player",
  "appName": "Matrix 8K Player",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0e0e0f"
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0e0e0f", "overlaysWebView": false }
  }
}
