{
  "appId": "tv.orbit.player",
  "appName": "Matrix TV Streams",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0709"
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0b0709", "overlaysWebView": false }
  }
}
